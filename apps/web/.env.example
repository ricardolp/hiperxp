# URL canônica (sitemap, Open Graph, canonical). Padrão: https://hiperxp.com
# VITE_SITE_URL=https://hiperxp.com

# API do catálogo Database (Postgres). Vazia = usa /database/*.json.
# Se a API estiver fora, o restante do site continua normal.
# VITE_DATABASE_API_URL=http://localhost:4000

# Base dos ícones de item (sem barra final). Em prod o padrão é jsDelivr do repo.
# VITE_DATABASE_ICONS_BASE=https://cdn.jsdelivr.net/gh/ricardolp/hiperxp@master/data/fixtures/sources/client-br-levelup/icons-all

# Preenchidas no build de produção. Vazias, o site sobe sem rastreio Umami.
# VITE_UMAMI_SCRIPT_URL=https://seu-umami.up.railway.app/script.js
# VITE_UMAMI_WEBSITE_ID=

# Google Analytics 4 (Measurement ID) está em apps/web/index.html: G-ZECKM8ZEQW

