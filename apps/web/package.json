{
  "name": "@hiperxp/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "seo:generate": "node scripts/generate-seo-files.mjs",
    "seo:prerender": "node scripts/prerender-seo-html.mjs",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/copy-database-icons.mjs && node scripts/prerender-seo-html.mjs",
    "icons:copy": "node scripts/copy-database-icons.mjs",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "start": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "echo \"web tests pending\"",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@hiperxp/contracts": "workspace:*",
    "@hiperxp/drop-engine": "workspace:*",
    "idb-keyval": "^6.2.2",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.4",
    "serve": "^14.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~5.9.2",
    "vite": "^8.3.6"
  }
}
