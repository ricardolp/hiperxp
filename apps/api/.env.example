# Postgres catalog DB (NOT the Umami database name).
# Same instance is fine: change only the database name to hiperxp.
DATABASE_URL=postgresql://user:pass@host:5432/hiperxp
# DATABASE_SSLMODE=require

PORT=4000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://hiperxp.com

# Soft limits (per IP)
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_VIEW_PER_MIN=30
