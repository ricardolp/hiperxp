{
  "name": "hiperxp",
  "private": true,
  "version": "0.1.0",
  "description": "Ferramentas comunitárias Perfect World — mapas e simulador de baús",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardolp/hiperxp.git"
  },
  "homepage": "https://github.com/ricardolp/hiperxp#readme",
  "bugs": {
    "url": "https://github.com/ricardolp/hiperxp/issues"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter @hiperxp/web dev",
    "dev:api": "pnpm --filter @hiperxp/api dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:import": "python tools/import-database-pg.py"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
